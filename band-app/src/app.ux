<script>
const interconnect = require("@system.interconnect");
const gestureLib = require("./common/gesture");

/**
 * 手环端链路层。严格按小米官方示例 interconnect-demo 的形态写。
 *
 * 官方示例的关键做法（我一开始全都漏了）：
 * 1. 每次用之前 this._connect = interconnect.instance() 重建实例，
 *    然后立刻重新绑定 onmessage / onopen / onclose / onerror。
 *    只在 onCreate 里绑一次，后面就收不到消息。
 * 2. 发送前用 getReadyState() 确认连接状态（1=连接成功）。
 * 3. send 的 success / fail 必须是函数，传字符串会走错误分支。
 * 4. 发送用 { data: ... } 对象形式。
 *
 * 不使用 system.vibrator：require 未在 manifest features 声明的模块，
 * aiot-toolkit 会直接报 "Copy resource files error: missing feature"。
 */
export default {
  onLink: "unknown",
  battery: -1,
  listening: false,
  page: null,

  // ---- 体感状态 ----
  tiltOn: false,          // 开关
  recording: false,       // 是否在学习录制
  recorder: null,         // 当前录制器
  sensorSubscribed: false,

  onCreate() {
    this._lastError = "";
    this._rebuild();
  },

  _rebuild() {
    try {
      this._connect = interconnect.instance();
      const conn = this._connect;
      conn.onmessage = (res) => {
        try {
          const data = res && res.data !== undefined ? res.data : res;
          let frame = data;
          if (typeof data === "string") {
            try { frame = JSON.parse(data); } catch (e) { frame = null; }
          }
          if (!frame || typeof frame !== "object") return;
          this._handleFrame(frame);
        } catch (err) {
          // 单帧失败不影响后续
        }
      };
      conn.onopen = () => { this.onLink = "connected"; this._push(); };
      conn.onclose = () => { this.onLink = "disconnected"; this._push(); };
      conn.onerror = () => { this.onLink = "error"; this._push(); };
    } catch (e) {
      this.onLink = "unavailable";
      this._lastError = "instance 失败: " + errText(e);
    }
  },

  onDestroy() {
    this._unsubscribeSensor();
    const conn = this._connect;
    if (!conn) return;
    try {
      conn.onmessage = null; conn.onopen = null;
      conn.onclose = null; conn.onerror = null;
    } catch (e) { /* 解绑失败不影响退出 */ }
  },

  _handleFrame(frame) {
    if (frame.kind === "status") {
      this.onLink = frame.link === "connected" ? "connected" : "disconnected";
      this.battery = typeof frame.battery === "number" ? frame.battery : -1;
      this.listening = frame.listening === true;
      this._push();
      return;
    }
    if (frame.kind === "gsync") {
      this.applyGestureList(frame.list);
      if (this.page && typeof this.page.onTemplates === "function") {
        this.page.onTemplates(this._templates);
      }
      return;
    }
    if (frame.kind === "ack") {
      if (this.page && typeof this.page.onAck === "function") this.page.onAck(frame.refId);
    }
  },

  _push() {
    if (this.page && typeof this.page.onStatus === "function") {
      this.page.onStatus({
        link: this.onLink,
        battery: this.battery,
        listening: this.listening,
        tiltOn: this.tiltOn,
      });
    }
  },

  attachPage(page) { this.page = page; this._push(); },
  detachPage() { this.page = null; },

  send(cmd, onResult) {
    this._lastError = "";
    try {
      // 闭源 ControlPhone 的做法：构造时建一次实例，之后一直复用，
      // **不重建、不查 getApkStatus、不等待**，直接 send。
      // 每次重建会让连接重新绑定，绑定期间状态必然未就绪。
      if (!this._connect) this._rebuild();
      const conn = this._connect;
      if (!conn) {
        this._lastError = "连接实例不可用";
        if (onResult) onResult(false, this._lastError);
        return false;
      }
      // 官方示例 getData() 直接返回对象/字符串，**不自己 JSON.stringify**。
      // 传字符串会被对端当非法格式（fail: invalid）。
      // 这里直接传对象，让 SDK 自己序列化。
      conn.send({
        data: cmd,
        success: () => { this._lastError = ""; if (onResult) onResult(true, ""); },
        fail: (res, code) => {
          const raw = res && res.data !== undefined ? res.data : errText(res);
          this._lastError = String(raw);
          this._lastCode = String(code === undefined ? "?" : code);
          this._lastCmd = cmd && cmd.t ? cmd.t : "";
          if (onResult) onResult(false, this._lastError);
        },
      });
      return true;
    } catch (e) {
      this._lastError = "send 抛出: " + errText(e);
      if (onResult) onResult(false, this._lastError);
      return false;
    }
  },

  /**
   * 查连接状态。
   *
   * 官方实现里回调的 res.status 是**直接属性**（不是 res.data.status）：
   *   success: (res) => { this.statusNum = res.status }
   *   status == 1 连接成功，== 2 连接失败
   */
  readyState(onResult) {
    try {
      const conn = this._connect || interconnect.instance();
      conn.getReadyState({
        success: (res) => {
          const status = res && res.status !== undefined ? res.status : -1;
          this._readyState = status;
          if (onResult) onResult(status);
        },
        fail: (res, code) => {
          this._readyState = -1;
          this._readyFail = "code=" + (code === undefined ? "?" : code);
          if (onResult) onResult(-1);
        },
      });
    } catch (e) {
      if (onResult) onResult(-1);
    }
  },

  /**
   * 等链路可用再发送。
   *
   * 官方 onShow 里先 getApkStatusConnecting()：建连接 + 查 getApkStatus()。
   * 这个状态决定能不能发——不看它直接 send 就会 not connected。
   * apkStatus 是同步返回值，这里轮询等它变成可用状态。
   */
  /**
   * 查一次链路状态，**不重建连接**。
   *
   * 闭源 ControlPhone 压根不查这个就直接 send，说明它不该作为发送前置条件。
   * 这里只用来在诊断层显示，不阻塞发送。
   */
  waitReady(onResult) {
    let status = -1;
    try {
      if (!this._connect) this._rebuild();
      status = this._connect && typeof this._connect.getApkStatus === "function"
        ? this._connect.getApkStatus()
        : -1;
    } catch (e) {
      status = -1;
    }
    this._apkStatus = status;
    // 永远回调 true：不让状态查询挡住发送
    if (onResult) onResult(true, status);
  },

  /** 官方提供的另一个状态接口：同步返回 apkStatus。 */
  apkStatus() {
    try {
      const conn = this._connect || interconnect.instance();
      return conn && typeof conn.getApkStatus === "function" ? conn.getApkStatus() : -1;
    } catch (e) {
      return -1;
    }
  },

  /** 官方诊断接口：拿更详细的连接诊断码。 */
  diagnosis(onResult) {
    try {
      const conn = this._connect || interconnect.instance();
      conn.diagnosis({
        timeout: 2000,
        success: (res) => { if (onResult) onResult("ok status=" + (res && res.status)); },
        fail: (res, code) => { if (onResult) onResult("fail code=" + code); },
      });
    } catch (e) {
      if (onResult) onResult("抛出: " + errText(e));
    }
  },

  lastError() { return this._lastError || ""; },

  // ================= 体感控制 =================

  /** 开/关体感模式。开启时订阅加速度计。 */
  setTilt(on) {
    if (this.tiltOn === on) return;
    this.tiltOn = on;
    if (on) {
      this._subscribeSensor();
    } else {
      this._unsubscribeSensor();
    }
    this.send({ t: "tilt", on: on });
    this._push();
  },

  _subscribeSensor() {
    if (this.sensorSubscribed) return;
    try {
      const sensor = require("@system.sensor");
      this._sensor = sensor;
      sensor.subscribeAccelerometer({
        interval: gestureLib.INTERVAL,
        callback: (ret) => this._onAccel(ret),
        fail: (msg, code) => {
          this._lastError = "传感器订阅失败 code=" + code;
          this.tiltOn = false;
          this._push();
        },
      });
      this.sensorSubscribed = true;
    } catch (e) {
      this._lastError = "无法订阅传感器: " + errText(e);
      this.tiltOn = false;
      this._push();
    }
  },

  _unsubscribeSensor() {
    if (!this.sensorSubscribed) return;
    try {
      if (this._sensor) this._sensor.unsubscribeAccelerometer();
    } catch (e) {
      // 取消订阅失败不影响关闭
    }
    this.sensorSubscribed = false;
  },

  /**
   * 加速度采样回调。
   *
   * 手环屏幕朝上时：x 左右、y 上下、z 垂直屏幕。
   * 只用 x/y 算倾角；z 作为"是否戴在手上"的参考不参与识别。
   */
  _onAccel(ret) {
    if (!ret) return;
    const x = ret.x || 0;
    const y = ret.y || 0;

    if (this.recording && this.recorder) {
      // 学习模式：喂给录制器
      this.recorder.feed(x, y);
      if (this.page && typeof this.page.onRecord === "function") {
        this.page.onRecord(this.recorder.path(), this.recorder.hint());
      }
      return;
    }

    if (!this.tiltOn) return;

    // 正常模式：实时手势识别
    if (!this._live) this._live = gestureLib.createRecorder();
    this._live.feed(x, y);

    if (this.page && typeof this.page.onTilt === "function") {
      this.page.onTilt(this._live.hint(), this._live.path());
    }

    // 静止足够久 -> 手势结束，尝试匹配
    if (this._live.isIdle()) {
      const path = this._live.finish();
      this._live.start();
      this._fireGesture(path);
    }
  },

  /** 识别到一个手势，发给手机（映射在手机端做）。 */
  _fireGesture(path) {
    if (!path || path.length === 0) return;
    const text = path.join(",");
    this._lastGesture = text;
    if (this.page && typeof this.page.onGesture === "function") {
      this.page.onGesture(text);
    }
    this.send({ t: "gesture", path: text });
  },

  /** 开始学习录制。 */
  startRecord() {
    this.recording = true;
    this.recorder = gestureLib.createRecorder();
    this.recorder.start();
    this._subscribeSensor();
  },

  /** 结束学习，返回录到的方向序列。 */
  stopRecord() {
    this.recording = false;
    const path = this.recorder ? this.recorder.finish() : [];
    this.recorder = null;
    if (!this.tiltOn) this._unsubscribeSensor();
    return path;
  },

  /** 接收手机下发的手势模板列表。 */
  applyGestureList(list) {
    this._templates = Array.isArray(list) ? list : [];
  },

  templates() { return this._templates || []; },

  /** 完整失败详情，供诊断层显示。 */
  lastDetail() {
    return { cmd: this._lastCmd || "", code: this._lastCode || "", msg: this._lastError || "" };
  },
  buzz() { /* 不用 vibrator */ },
};

function errText(e) {
  if (!e) return "unknown";
  if (e.message) return String(e.message);
  try { return JSON.stringify(e); } catch (x) { return String(e); }
}
</script>