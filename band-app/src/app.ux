<script>
// 闭源 ControlPhone 用的是 @app-module/ 前缀（编译后形态），
  // 源码形态是 @system.*。两种都试，取到哪个用哪个。
const interconnect = require("@system.interconnect");

// 震动不是必需功能。闭源 ControlPhone 完全没用 vibrator 模块，
// 说明它需要额外权限、且可能影响链路初始化。这里延迟加载 + 完全静默：
// 取不到就不震，绝不让它挡住主流程。
let vibrator = null;
try {
  vibrator = require("@system.vibrator");
} catch (e) {
  vibrator = null;
}

/**
 * 手环端链路层。
 *
 * 官方 interconnect 的用法（照抄自小米官方示例与导航环实测通过的实现）：
 * - 监听：connect.onmessage = (event) => {}   是**属性赋值**，不是方法调用
 * - 发送：connect.send({ data, success, fail })   必须带回调对象
 * - 生命周期：onopen / onclose / onerror 也是属性赋值
 *
 * 之前写成 onMessage(cb) / send(str)，运行时根本不会收到消息，
 * 表现为手环一直显示「未连接手机」——手机端发什么都没人接。
 *
 * event 的形状是 { data: ... }，data 可能是字符串也可能是对象，两种都要接。
 */
export default {
  onLink: "unknown",
  battery: -1,
  listening: false,
  page: null,

  onCreate() {
    try {
      const connect = interconnect.instance();
      this._connect = connect;

      // ---- 收消息 ----
      connect.onmessage = (event) => {
        try {
          const data = event && event.data !== undefined ? event.data : event;
          let decoded = data;
          if (typeof data === "string") {
            try {
              decoded = JSON.parse(data);
            } catch (e) {
              decoded = null;
            }
          }
          if (!decoded || typeof decoded !== "object") return;
          this._handleFrame(decoded);
        } catch (err) {
          // 单帧解析失败不能影响后续帧
        }
      };

      // ---- 链路状态 ----
      connect.onopen = () => {
        this.onLink = "connected";
        this._push();
      };
      connect.onclose = () => {
        this.onLink = "disconnected";
        this._push();
      };
      connect.onerror = () => {
        this.onLink = "error";
        this._push();
      };
    } catch (e) {
      this.onLink = "unavailable";
    }
  },

  onDestroy() {
    const connect = this._connect;
    if (!connect) return;
    try {
      connect.onmessage = null;
      connect.onopen = null;
      connect.onclose = null;
      connect.onerror = null;
    } catch (e) {
      // 解绑失败不影响退出
    }
  },

  _handleFrame(frame) {
    if (frame.kind === "status") {
      this.onLink = frame.link === "connected" ? "connected" : "disconnected";
      this.battery = typeof frame.battery === "number" ? frame.battery : -1;
      this.listening = frame.listening === true;
      this._push();
      this._ack(frame.id);
      return;
    }
    if (frame.kind === "ack") {
      if (this.page && typeof this.page.onAck === "function") {
        this.page.onAck(frame.refId);
      }
    }
  },

  _ack(refId) {
    this.send({ t: "ack", refId: refId || "status" });
  },

  _push() {
    if (this.page && typeof this.page.onStatus === "function") {
      this.page.onStatus({
        link: this.onLink,
        battery: this.battery,
        listening: this.listening,
      });
    }
  },

  /** 页面注册自己，用于接收状态与回执。 */
  attachPage(page) {
    this.page = page;
    this._push();
  },

  detachPage() {
    this.page = null;
  },

  /**
   * 发送一条指令。
   *
   * 官方签名是 send({ data, success, fail })，不能直接传字符串。
   * 返回 true 只表示已交给链路层，不代表手机执行成功。
   */
  send(cmd) {
    const connect = this._connect;
    if (!connect) return false;
    try {
      // 只传 { data }，不带 success/fail —— 闭源 ControlPhone 在真机上跑通的形态。
      // 多传回调可能让参数校验失败并静默丢弃。
      connect.send({ data: JSON.stringify(cmd) });
      return true;
    } catch (e) {
      return false;
    }
  },

  /** 轻震反馈；取不到震动模块就跳过，绝不抛异常。 */
  buzz() {
    if (!vibrator) return;
    try {
      vibrator.vibrate({ mode: "short" });
    } catch (e) {
      // 手环不支持震动时忽略
    }
  },
};
</script>