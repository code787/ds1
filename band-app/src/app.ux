<script>
// 闭源 ControlPhone 用的是 @app-module/ 前缀（编译后形态），
  // 源码形态是 @system.*。两种都试，取到哪个用哪个。
const interconnect = require("@system.interconnect");

// 不用 system.vibrator：闭源 ControlPhone（用户真机跑通）只用
// app / battery / device / interconnect 四个模块，没有 vibrator。
// 而且代码里 require 了未在 manifest features 声明的模块，
// aiot-toolkit 会直接报 "afterCompile: Copy resource files error: missing feature"。
// 震动不是核心功能，去掉。

/**
 * 手环端链路层。
 *
 * 官方 interconnect 的用法（照抄自小米官方示例与导航环实测通过的实现）：
 * - 监听：connect.onmessage = (event) => {}   是**属性赋值**，不是方法调用
 * - 发送：connect.send({ data, success, fail })   必须带回调对象
 * - 生命周期：onopen / onclose / onerror 也是属性赋值
 *
 * 之前写成 onMessage(cb) / send(str)，运行时根本不会收到消息，
 * 表现为手环一直显示「未连接手机」——手机端发什么都没人接。
 *
 * event 的形状是 { data: ... }，data 可能是字符串也可能是对象，两种都要接。
 */
/** 把异常转成可读文本，Vela 里 e.message 不一定存在。 */
function errText(e) {
  if (!e) return "unknown";
  if (e.message) return String(e.message);
  try {
    return JSON.stringify(e);
  } catch (x) {
    return String(e);
  }
}

export default {
  onLink: "unknown",
  battery: -1,
  listening: false,
  page: null,

  onCreate() {
    try {
      const connect = interconnect.instance();
      this._connect = connect;

      // ---- 收消息 ----
      connect.onmessage = (event) => {
        try {
          const data = event && event.data !== undefined ? event.data : event;
          let decoded = data;
          if (typeof data === "string") {
            try {
              decoded = JSON.parse(data);
            } catch (e) {
              decoded = null;
            }
          }
          if (!decoded || typeof decoded !== "object") return;
          this._handleFrame(decoded);
        } catch (err) {
          // 单帧解析失败不能影响后续帧
        }
      };

      // ---- 链路状态 ----
      connect.onopen = () => {
        this.onLink = "connected";
        this._push();
        // 连上后立刻握手，告诉手机端「我在」
        this.handshake();
      };
      connect.onclose = () => {
        this.onLink = "disconnected";
        this._push();
      };
      connect.onerror = () => {
        this.onLink = "error";
        this._push();
      };
    } catch (e) {
      this.onLink = "unavailable";
    }
  },

  onDestroy() {
    const connect = this._connect;
    if (!connect) return;
    try {
      connect.onmessage = null;
      connect.onopen = null;
      connect.onclose = null;
      connect.onerror = null;
    } catch (e) {
      // 解绑失败不影响退出
    }
  },

  _handleFrame(frame) {
    if (frame.kind === "status") {
      this.onLink = frame.link === "connected" ? "connected" : "disconnected";
      this.battery = typeof frame.battery === "number" ? frame.battery : -1;
      this.listening = frame.listening === true;
      this._push();
      this._ack(frame.id);
      return;
    }
    if (frame.kind === "ack") {
      if (this.page && typeof this.page.onAck === "function") {
        this.page.onAck(frame.refId);
      }
    }
  },

  _ack(refId) {
    this.send({ t: "ack", refId: refId || "status" });
  },

  _push() {
    if (this.page && typeof this.page.onStatus === "function") {
      this.page.onStatus({
        link: this.onLink,
        battery: this.battery,
        listening: this.listening,
      });
    }
  },

  /** 页面注册自己，用于接收状态与回执。 */
  attachPage(page) {
    this.page = page;
    this._push();
  },

  detachPage() {
    this.page = null;
  },

  /**
   * 发送一条指令。
   *
   * 反编译 ControlPhone（真机跑通）后发现它有两种 send 形式：
   *   conn.send("control", payload)     ← 通道名 + 对象，业务指令用这个
   *   conn.send({ data: {...} })        ← 对象形式，握手用这个
   *
   * 它还有握手：连上后先发 { tag: "__hs__" } 标记就绪，之后才发业务消息。
   *
   * 这里两种都试，成功一个就返回；把失败原因留给页面显示，便于诊断。
   */
  send(cmd) {
    const connect = this._connect;
    if (!connect) {
      this._lastSendError = "connect 不存在";
      return false;
    }
    const text = JSON.stringify(cmd);

    try {
      connect.send({ data: text });
      this._lastSendError = "";
      return true;
    } catch (e1) {
      this._lastSendError = "对象形式失败: " + errText(e1);
    }

    try {
      connect.send("control", cmd);
      this._lastSendError = "";
      return true;
    } catch (e2) {
      this._lastSendError += " / 通道形式失败: " + errText(e2);
      return false;
    }
  },

  /** 握手：告诉手机「我准备好了」。失败不阻塞。 */
  handshake() {
    const connect = this._connect;
    if (!connect) return;
    try {
      connect.send({ data: JSON.stringify({ tag: "__hs__", count: 1, app: "wristcontrol" }) });
    } catch (e) {
      // 握手失败不影响后续
    }
  },

  /** 供页面显示最后一次发送错误。 */
  lastError() {
    return this._lastSendError || "";
  },

  /** 震动反馈占位。当前不启用（见文件头说明）。 */
  buzz() {
    // 有意留空
  },
};
</script>