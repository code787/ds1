<script>
const interconnect = require("@system.interconnect");
const vibrator = require("@system.vibrator");
const sensor = require("@system.sensor");
const { parseFrame } = require("./common/protocol");

const connect = interconnect.instance();
const SEND_RETRY = 2;

/**
 * 与手机的链路层（CommonJS）。
 *
 * 收到的帧有两种：
 * - kind=status：手机状态（链路、电量、手势服务是否开启）
 * - kind=ack   ：手机确认收到某条指令
 *
 * 约束：
 * - 收到 status 立刻回 ack，让手机知道链路活着；
 * - 发送失败重试次数有上限，避免堆积；
 * - 震动失败不影响功能。
 */
export default {
  onCreate() {
    this.page = null;
    this.link = "connecting";
    this.battery = -1;
    this.listening = false;

    // ---- 体感（只发原始数据，不做任何计算）----
    this.tiltOn = false;
    this.sensorSubscribed = false;

    this._onMessage = (payload) => this.handleFrame(payload);
    try {
      connect.onMessage(this._onMessage);
    } catch (e) {
      console.error("onMessage 注册失败", e);
    }
  },

  onDestroy() {
    this._unsubscribe();
    try {
      connect.offMessage(this._onMessage);
    } catch (e) {
      // 解绑失败不影响退出
    }
  },

  attachPage(page) {
    this.page = page;
    this.pushStatus();
  },

  detachPage() {
    this.page = null;
  },

  handleFrame(payload) {
    const frame = parseFrame(payload);
    if (!frame) return;

    if (frame.kind === "ack") {
      if (this.page) this.page.onAck(frame.refId);
      return;
    }

    this.link = frame.link;
    this.battery = frame.battery;
    this.listening = frame.listening;
    this.pushStatus();
    this.ack(frame.id);
  },

  ack(refId) {
    try {
      connect.send(JSON.stringify({ t: "ack", refId: refId || "status" }));
    } catch (e) {
      // ack 失败无需处理，下一次心跳会重新确认链路
    }
  },

  pushStatus() {
    if (!this.page) return;
    this.page.onStatus({
      link: this.link,
      battery: this.battery,
      listening: this.listening,
      tiltOn: this.tiltOn,
    });
  },

  /** 发送一条指令。返回 true 表示已交给链路层（不代表手机执行成功）。 */
  send(cmd) {
    const text = JSON.stringify(cmd);
    for (let i = 0; i <= SEND_RETRY; i++) {
      try {
        connect.send(text);
        return true;
      } catch (e) {
        if (i === SEND_RETRY) {
          console.error("发送失败", e);
          return false;
        }
      }
    }
    return false;
  },

  /**
   * 开/关体感。开启时订阅加速度计，只把原始 x/y/z 发给手机。
   *
   * **不做任何计算**——滤波、方向判断、手势识别全在手机端。
   * 这样手环端逻辑最简单，出问题也容易定位。
   */
  setTilt(on) {
    this.tiltOn = on;
    if (on) {
      this._subscribe();
    } else {
      this._unsubscribe();
    }
    this.send({ t: "tilt", on: on });
    this.pushStatus();
  },

  _subscribe() {
    if (this.sensorSubscribed) return;
    try {
      sensor.subscribeAccelerometer({
        interval: "game",
        callback: (ret) => {
          if (!ret) return;
          if (!this.tiltOn) return;
          // 只发原始值，一个字节的计算都不做
          this.send({
            t: "raw",
            x: ret.x,
            y: ret.y,
            z: ret.z === undefined ? 0 : ret.z,
          });
        },
        fail: (msg, code) => {
          this.sensorSubscribed = false;
          this.send({ t: "sensor", ok: false, msg: "code=" + code });
        },
      });
      this.sensorSubscribed = true;
      this.send({ t: "sensor", ok: true, msg: "已订阅" });
    } catch (e) {
      this.sensorSubscribed = false;
      this.send({ t: "sensor", ok: false, msg: String(e) });
    }
  },

  _unsubscribe() {
    if (!this.sensorSubscribed) return;
    try {
      sensor.unsubscribeAccelerometer();
    } catch (e) {
      // 取消订阅失败不影响关闭
    }
    this.sensorSubscribed = false;
  },

  buzz() {
    try {
      vibrator.start({ mode: "short", count: 1 });
    } catch (e) {
      // 手环不支持震动时不影响功能
    }
  },
};
</script>