<script>
const interconnect = require("@system.interconnect");
const buzz = require("./common/buzz");

/**
 * 手环端链路层。严格按小米官方示例 interconnect-demo 的形态写。
 *
 * 官方示例的关键做法（我一开始全都漏了）：
 * 1. 每次用之前 this._connect = interconnect.instance() 重建实例，
 *    然后立刻重新绑定 onmessage / onopen / onclose / onerror。
 *    只在 onCreate 里绑一次，后面就收不到消息。
 * 2. 发送前用 getReadyState() 确认连接状态（1=连接成功）。
 * 3. send 的 success / fail 必须是函数，传字符串会走错误分支。
 * 4. 发送用 { data: ... } 对象形式。
 *
 * system.vibrator 已在 manifest features 声明，震动反馈走 common/buzz.js。
 * require 未声明的模块会让 aiot-toolkit 报 "Copy resource files error: missing feature"。
 */
export default {
  onLink: "unknown",
  battery: -1,
  listening: false,
  page: null,

  // ---- 体感配置（由手机下发） ----
  cfg: {
    deadZoneH: 18,
    deadZoneV: 18,
    holdMs: 120,
    idleEndMs: 600,
    // 手环横向佩戴：屏幕长边水平，加速度计 x/y 轴相对"用户以为的上下左右"
    // 整体偏了 90 度。默认 90，用户可以在 App 里微调。
    rotationOffset: 90,
    // 匹配容错：0=必须完全一致，1=允许差一个方向，2=更宽松
    tolerance: 1,
    live: true,
  },

  // ---- 体感状态 ----
  tiltOn: false,          // 开关
  recording: false,       // 是否在学习录制
  sensorSubscribed: false,

  onCreate() {
    this._lastError = "";
    this._rebuild();
  },

  _rebuild() {
    try {
      this._connect = interconnect.instance();
      const conn = this._connect;
      conn.onmessage = (res) => {
        try {
          const data = res && res.data !== undefined ? res.data : res;
          let frame = data;
          if (typeof data === "string") {
            try { frame = JSON.parse(data); } catch (e) { frame = null; }
          }
          if (!frame || typeof frame !== "object") return;
          this._handleFrame(frame);
        } catch (err) {
          // 单帧失败不影响后续
        }
      };
      conn.onopen = () => {
        this.onLink = "connected";
        this._reconnectDelay = 0;
        this._push();
      };
      conn.onclose = () => {
        this.onLink = "disconnected";
        this._push();
        this._scheduleReconnect();
      };
      conn.onerror = () => {
        this.onLink = "error";
        this._push();
        this._scheduleReconnect();
      };
    } catch (e) {
      this.onLink = "unavailable";
      this._lastError = "instance 失败: " + errText(e);
    }
  },

  /**
   * 断线后自动重连。
   *
   * 蓝牙抖一下、手机锁屏、走远再回来，都会断开。
   * 不做重连的话用户得手动重开 App——这是最影响体验的细节之一。
   * 间隔从 1 秒起翻倍，最多 8 秒，避免频繁重建连接耗电。
   */
  _scheduleReconnect() {
    if (this._reconnectTimer) return;
    const delay = this._reconnectDelay > 0 ? this._reconnectDelay : 1000;
    this._reconnectTimer = setTimeout(() => {
      this._reconnectTimer = null;
      this._rebuild();
      this._reconnectDelay = Math.min(delay * 2, 8000);
    }, delay);
  },

  onDestroy() {
    if (this._reconnectTimer) {
      clearTimeout(this._reconnectTimer);
      this._reconnectTimer = null;
    }
    this._unsubscribeSensor();
    const conn = this._connect;
    if (!conn) return;
    try {
      conn.onmessage = null; conn.onopen = null;
      conn.onclose = null; conn.onerror = null;
    } catch (e) { /* 解绑失败不影响退出 */ }
  },

  _handleFrame(frame) {
    if (frame.kind === "status") {
      this.onLink = frame.link === "connected" ? "connected" : "disconnected";
      this.battery = typeof frame.battery === "number" ? frame.battery : -1;
      this.listening = frame.listening === true;
      // 状态帧只用于显示，**不主动改开关**。
      //
      // 之前这里按手机的 tilt 值订阅/退订传感器，而手机端 tiltOn 初始 false，
      // 结果手环一连上就被强制关掉体感——用户点了开关，5 秒后又被关。
      // 开关的主动权必须留在手环（用户手上），手机只做展示。
      this._push();
      return;
    }
    if (frame.kind === "cfg") {
      // 手机端下发的是 deadZoneH/deadZoneV（左右/上下分开），兼容旧的 deadZone
      if (typeof frame.deadZoneH === "number") this.cfg.deadZoneH = frame.deadZoneH;
      if (typeof frame.deadZoneV === "number") this.cfg.deadZoneV = frame.deadZoneV;
      if (typeof frame.deadZone === "number") {
        this.cfg.deadZoneH = frame.deadZone;
        this.cfg.deadZoneV = frame.deadZone;
      }
      if (typeof frame.holdMs === "number") this.cfg.holdMs = frame.holdMs;
      if (typeof frame.idleEndMs === "number") this.cfg.idleEndMs = frame.idleEndMs;
      if (typeof frame.rotationOffset === "number") this.cfg.rotationOffset = frame.rotationOffset;
      if (typeof frame.tolerance === "number") this.cfg.tolerance = frame.tolerance;
      if (typeof frame.live === "boolean") this.cfg.live = frame.live;
      // 配置变了要重建录制器，否则旧参数还在用
      this._live = null;
      if (this.page && typeof this.page.onConfig === "function") {
        this.page.onConfig(this.cfg);
      }
      return;
    }
    if (frame.kind === "ack") {
      if (this.page && typeof this.page.onAck === "function") this.page.onAck(frame.refId);
      return;
    }
    if (frame.kind === "calres") {
      // 姿势校准结果：手机采完样才回，ok/msg 直接给页面显示
      if (this.page && typeof this.page.onCalResult === "function") {
        this.page.onCalResult(frame.ok === true, frame.msg || "");
      }
    }
  },

  _push() {
    if (this.page && typeof this.page.onStatus === "function") {
      this.page.onStatus({
        link: this.onLink,
        battery: this.battery,
        listening: this.listening,
        tiltOn: this.tiltOn,
        sensorError: this.sensorSubscribed ? "" : (this._lastError || ""),
      });
    }
  },

  attachPage(page) { this.page = page; this._push(); },
  detachPage() { this.page = null; },

  send(cmd, onResult) {
    this._lastError = "";
    try {
      // 闭源 ControlPhone 的做法：构造时建一次实例，之后一直复用，
      // **不重建、不查 getApkStatus、不等待**，直接 send。
      // 每次重建会让连接重新绑定，绑定期间状态必然未就绪。
      if (!this._connect) this._rebuild();
      const conn = this._connect;
      if (!conn) {
        this._lastError = "连接实例不可用";
        if (onResult) onResult(false, this._lastError);
        return false;
      }
      // 官方示例 getData() 直接返回对象/字符串，**不自己 JSON.stringify**。
      // 传字符串会被对端当非法格式（fail: invalid）。
      // 这里直接传对象，让 SDK 自己序列化。
      conn.send({
        data: cmd,
        success: () => { this._lastError = ""; if (onResult) onResult(true, ""); },
        fail: (res, code) => {
          const raw = res && res.data !== undefined ? res.data : errText(res);
          this._lastError = String(raw);
          this._lastCode = String(code === undefined ? "?" : code);
          this._lastCmd = cmd && cmd.t ? cmd.t : "";
          if (onResult) onResult(false, this._lastError);
        },
      });
      return true;
    } catch (e) {
      this._lastError = "send 抛出: " + errText(e);
      if (onResult) onResult(false, this._lastError);
      return false;
    }
  },

  /**
   * 查连接状态。
   *
   * 官方实现里回调的 res.status 是**直接属性**（不是 res.data.status）：
   *   success: (res) => { this.statusNum = res.status }
   *   status == 1 连接成功，== 2 连接失败
   */
  readyState(onResult) {
    try {
      const conn = this._connect || interconnect.instance();
      conn.getReadyState({
        success: (res) => {
          const status = res && res.status !== undefined ? res.status : -1;
          this._readyState = status;
          if (onResult) onResult(status);
        },
        fail: (res, code) => {
          this._readyState = -1;
          this._readyFail = "code=" + (code === undefined ? "?" : code);
          if (onResult) onResult(-1);
        },
      });
    } catch (e) {
      if (onResult) onResult(-1);
    }
  },

  /**
   * 等链路可用再发送。
   *
   * 官方 onShow 里先 getApkStatusConnecting()：建连接 + 查 getApkStatus()。
   * 这个状态决定能不能发——不看它直接 send 就会 not connected。
   * apkStatus 是同步返回值，这里轮询等它变成可用状态。
   */
  /**
   * 查一次链路状态，**不重建连接**。
   *
   * 闭源 ControlPhone 压根不查这个就直接 send，说明它不该作为发送前置条件。
   * 这里只用来在诊断层显示，不阻塞发送。
   */
  waitReady(onResult) {
    let status = -1;
    try {
      if (!this._connect) this._rebuild();
      status = this._connect && typeof this._connect.getApkStatus === "function"
        ? this._connect.getApkStatus()
        : -1;
    } catch (e) {
      status = -1;
    }
    this._apkStatus = status;
    // 永远回调 true：不让状态查询挡住发送
    if (onResult) onResult(true, status);
  },

  /** 官方提供的另一个状态接口：同步返回 apkStatus。 */
  apkStatus() {
    try {
      const conn = this._connect || interconnect.instance();
      return conn && typeof conn.getApkStatus === "function" ? conn.getApkStatus() : -1;
    } catch (e) {
      return -1;
    }
  },

  /** 官方诊断接口：拿更详细的连接诊断码。 */
  diagnosis(onResult) {
    try {
      const conn = this._connect || interconnect.instance();
      conn.diagnosis({
        timeout: 2000,
        success: (res) => { if (onResult) onResult("ok status=" + (res && res.status)); },
        fail: (res, code) => { if (onResult) onResult("fail code=" + code); },
      });
    } catch (e) {
      if (onResult) onResult("抛出: " + errText(e));
    }
  },

  lastError() { return this._lastError || ""; },

  // ================= 体感控制 =================

  /**
   * 开/关体感模式。
   *
   * **关闭时只停止发送，不调用 unsubscribeAccelerometer。**
   *
   * 之前关闭时调 unsubscribeAccelerometer()，手环直接重启——
   * 这个接口在部分固件上会触发底层驱动崩溃。
   * 传感器订阅本身开销很小，保持订阅、只是不再发数据，
   * 用户看到的效果完全一样（没有数据了），但不会崩。
   *
   * 同理去掉所有提前返回：状态卡住时再点也要有反应。
   */
  setTilt(on) {
    this.tiltOn = on;
    if (on) {
      this._subscribeSensor();
    }
    // 关闭时什么都不做——_onAccel 里会检查 this.tiltOn，不再发送
    this.send({ t: "tilt", on: on });
    this._push();
  },

  _subscribeSensor() {
    // 已订阅就直接返回。绝不能调 unsubscribeAccelerometer——
    // 部分固件上它会触发底层驱动崩溃，手环直接重启（83a9fdd 的教训）。
    // 订阅失败时 fail 回调会把标志置回 false，标志不会失真。
    if (this.sensorSubscribed) return;
    try {
      const sensor = require("@system.sensor");
      this._sensor = sensor;
      sensor.subscribeAccelerometer({
        // interval 直接写死："game" 约 20ms 一帧。传 undefined 会导致订阅失败。
        interval: "game",
        callback: (ret) => this._onAccel(ret),
        fail: (msg, code) => {
          // 订阅失败**不改变开关状态**——开关是用户的意图，不是订阅结果。
          // 之前这里把 tiltOn 置 false，看起来像"开关自己关了"，
          // 实际是加速度计订阅失败。把失败原因显示出来，别偷偷关开关。
          this._lastError = "传感器订阅失败 code=" + code + " msg=" + (msg || "");
          this.sensorSubscribed = false;
          this._push();
        },
      });
      this.sensorSubscribed = true;
    } catch (e) {
      // 同上：订阅抛异常也不动开关，只记录原因
      this._lastError = "无法订阅传感器: " + errText(e);
      this.sensorSubscribed = false;
      this._push();
    }
  },

  /**
   * 取消订阅传感器。
   *
   * **不调用 unsubscribeAccelerometer**——那个接口在部分固件上
   * 会触发底层驱动崩溃，手环直接重启（实测过）。
   * 只标记状态，_onAccel 里靠 tiltOn 判断是否发送。
   */
  _unsubscribeSensor() {
    this.sensorSubscribed = false;
  },

  /**
   * 加速度采样回调。
   *
   * **手环只做一件事：把原始值发出去。**
   * 滤波、方向判断、手势识别全部在手机端做。
   *
   * 为什么不在手环算：
   * - 改算法/调参数要重装 RPK，手机上改立即生效
   * - 手环算完只发结果，出问题看不到中间过程
   * - 手环算力弱，卡尔曼跑在手机上更从容
   *
   * 代价是蓝牙流量大（20ms 一条），所以只在体感开启时发。
   */
  _onAccel(ret) {
    if (!ret) return;

    // 学习模式和识别模式都要原始数据，统一发给手机
    if (this.tiltOn || this.recording) {
      this.send({
        t: "raw",
        x: ret.x,
        y: ret.y,
        z: ret.z === undefined ? 0 : ret.z,
        rec: this.recording,
      });
    }
  },

  /**
   * 开始学习录制。
   *
   * 手环只标记 recording=true，让 _onAccel 继续发原始数据。
   * 识别逻辑全在手机端，所以这里不需要录制器。
   */
  startRecord() {
    this.recording = true;
    this._subscribeSensor();
  },

  /** 结束学习。识别结果由手机端自己算，这里只需停止标记。 */
  stopRecord() {
    this.recording = false;
    if (!this.tiltOn) this._unsubscribeSensor();
    return [];
  },



  /** 完整失败详情，供诊断层显示。 */
  lastDetail() {
    return { cmd: this._lastCmd || "", code: this._lastCode || "", msg: this._lastError || "" };
  },
  /** 震动反馈（盲操作时的确认通道）。kind: tick/ok/err/alarm。 */
  buzz(kind) {
    try {
      if (kind === "ok") buzz.ok();
      else if (kind === "err") buzz.err();
      else if (kind === "alarm") buzz.alarm();
      else buzz.tick();
    } catch (e) { /* 震动只是反馈，失败不影响功能 */ }
  },
};

function errText(e) {
  if (!e) return "unknown";
  if (e.message) return String(e.message);
  try { return JSON.stringify(e); } catch (x) { return String(e); }
}
</script>