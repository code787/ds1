<template>
  <div class="page">
    <div class="status">
      <text class="dot {{ linkOk ? 'dot-ok' : 'dot-bad' }}">{{ linkOk ? '●' : '○' }}</text>
      <text class="status-text">{{ statusText }}</text>
      <text class="battery" if="{{ batteryVisible }}">{{ batteryText }}</text>
    </div>

    <div class="pad" onswipe="onSwipe" onclick="onTap">
      <text class="pad-hint">{{ padHint }}</text>
      <text class="pad-error" if="{{ errorText }}">{{ errorText }}</text>
    </div>

    <div class="keys">
      <div class="key" onclick="onBack"><text class="key-label">返回</text></div>
      <div class="key" onclick="onHome"><text class="key-label">主页</text></div>
      <div class="key" onclick="onRecents"><text class="key-label">多任务</text></div>
    </div>
  </div>
</template>

<script>
/** 同一方向的滑动在冷却期内不重复发送。 */
const COOLDOWN_MS = 120;

export default {
  data: {
    linkOk: false,
    statusText: "正在连接",
    batteryVisible: false,
    batteryText: "",
    padHint: "等待手机连接",
    errorText: "",
  },

  onInit() {
    this._lastSendAt = 0;
    this._lastSwipe = "";
  },

  onShow() {
    // $app.$def 是 app.ux 导出的那个对象，页面与 app 共享同一实例
    const app = this.$app.$def;
    if (app && typeof app.attachPage === "function") {
      app.attachPage(this);
    }
  },

  onHide() {
    const app = this.$app.$def;
    if (app && typeof app.detachPage === "function") app.detachPage();
  },

  onDestroy() {
    const app = this.$app.$def;
    if (app && typeof app.detachPage === "function") app.detachPage();
  },

  /** 由 app.ux 推送链路状态。 */
  onStatus(status) {
    const linkOk = status.link === "connected";
    const listening = status.listening === true;

    if (this.linkOk !== linkOk) this.linkOk = linkOk;

    let text;
    if (status.link === "unknown") {
      text = "正在连接";
    } else if (!linkOk) {
      text = "未连接手机";
    } else if (!listening) {
      text = "手机手势服务未开";
    } else {
      text = "已连接";
    }
    if (this.statusText !== text) this.statusText = text;

    const batteryVisible = status.battery >= 0;
    if (this.batteryVisible !== batteryVisible) this.batteryVisible = batteryVisible;
    if (batteryVisible) {
      const batteryText = status.battery + "%";
      if (this.batteryText !== batteryText) this.batteryText = batteryText;
    }

    const padHint = linkOk && listening ? "滑动 / 点击" : "等待手机连接";
    if (this.padHint !== padHint) this.padHint = padHint;
  },

  /** 由 app.ux 推送手机回执。 */
  onAck(refId) {
    if (this.padHint === "已发送…") {
      this.padHint = this.linkOk ? "滑动 / 点击" : "等待手机连接";
    }
  },

  onSwipe(event) {
    if (!this.linkOk) {
      this.buzz();
      return;
    }
    const direction = event && event.direction;
    let dx = 0;
    let dy = 0;
    if (direction === "up") dy = -1;
    else if (direction === "down") dy = 1;
    else if (direction === "left") dx = -1;
    else if (direction === "right") dx = 1;
    else return;

    const now = Date.now();
    if (this._lastSwipe === direction && now - this._lastSendAt < COOLDOWN_MS) return;
    this._lastSwipe = direction;
    this._send({ t: "move", dx: dx, dy: dy });
  },

  onTap() {
    if (!this.linkOk) {
      this.buzz();
      return;
    }
    this._lastSwipe = "";
    this._send({ t: "tap" });
  },

  onBack() {
    if (!this.linkOk) return;
    this._send({ t: "back" });
  },

  onHome() {
    if (!this.linkOk) return;
    this._send({ t: "home" });
  },

  onRecents() {
    if (!this.linkOk) return;
    this._send({ t: "recents" });
  },

  _send(cmd) {
    this._lastSendAt = Date.now();
    const app = this.$app.$def;
    if (!app || typeof app.send !== "function") {
      this.errorText = "app 实例不可用";
      return;
    }
    const ok = app.send(cmd);
    // 把发送结果直接显示在页面上——手环端没有 adb，这是唯一的现场反馈
    const err = typeof app.lastError === "function" ? app.lastError() : "";
    const text = ok ? "已发送 " + (cmd.t || "") : "发送失败: " + err;
    if (this.padHint !== text) this.padHint = text;
    if (this.errorText !== err) this.errorText = err;
  },

  buzz() {
    const app = this.$app.$def;
    if (app && typeof app.buzz === "function") app.buzz();
  },
};
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding: 6px;
}
.status {
  flex-direction: row;
  align-items: center;
  height: 28px;
  padding-left: 4px;
  padding-right: 4px;
}
.dot { font-size: 16px; margin-right: 6px; }
.dot-ok { color: #00ff99; }
.dot-bad { color: #ff5555; }
.status-text { font-size: 15px; color: #cccccc; flex: 1; }
.battery { font-size: 15px; color: #888888; }
.pad {
  flex: 1;
  margin-top: 6px;
  margin-bottom: 6px;
  border-radius: 14px;
  border-width: 1px;
  border-color: #333333;
  background-color: #111111;
  justify-content: center;
  align-items: center;
}
.pad-hint { font-size: 17px; color: #666666; text-align: center; }
.pad-error { font-size: 12px; color: #ff6666; text-align: center; margin-top: 4px; }
.keys { flex-direction: row; height: 62px; }
.key {
  flex: 1;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 12px;
  background-color: #1f1f1f;
  justify-content: center;
  align-items: center;
}
.key-label { font-size: 18px; color: #ffffff; text-align: center; }
</style>