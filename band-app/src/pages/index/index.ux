<template>
  <div class="page">
    <div class="status">
      <text class="dot {{ linkOk ? 'dot-ok' : 'dot-bad' }}">{{ linkOk ? '●' : '○' }}</text>
      <text class="status-text" onlongpress="checkReady">{{ statusText }}</text>
      <text class="battery" if="{{ batteryVisible }}">{{ batteryText }}</text>
    </div>

    <!-- 诊断层：显示完整错误信息，点任意处关闭 -->
    <div class="diag" if="{{ diagOpen }}" onclick="closeDiag">
      <text class="diag-title">发送诊断</text>
      <text class="diag-line" if="{{ diagCmd }}">指令: {{ diagCmd }}</text>
      <text class="diag-line" if="{{ diagCode }}">code: {{ diagCode }}</text>
      <text class="diag-line" if="{{ diagMsg }}">msg: {{ diagMsg }}</text>
      <text class="diag-line" if="{{ diagReady }}">{{ diagReady }}</text>
      <text class="diag-line" if="{{ diagApk }}">{{ diagApk }}</text>
      <text class="diag-line" if="{{ diagDiag }}">{{ diagDiag }}</text>
      <text class="diag-tip">点任意处关闭</text>
    </div>

    <div class="pad" onswipe="onSwipe" onclick="onTap" onlongpress="openDiag">
      <text class="pad-hint">{{ padHint }}</text>
      <text class="pad-error" if="{{ errorText }}">{{ errorText }}</text>
    </div>

    <div class="keys">
      <div class="key" onclick="onBack"><text class="key-label">返回</text></div>
      <div class="key" onclick="onHome"><text class="key-label">主页</text></div>
      <div class="key" onclick="onRecents"><text class="key-label">多任务</text></div>
    </div>
  </div>
</template>

<script>
/** 同一方向的滑动在冷却期内不重复发送。 */
const COOLDOWN_MS = 120;

export default {
  data: {
    linkOk: false,
    statusText: "正在连接",
    batteryVisible: false,
    batteryText: "",
    padHint: "等待手机连接",
    errorText: "",
    diagOpen: false,
    diagCmd: "",
    diagCode: "",
    diagMsg: "",
    diagReady: "",
    diagApk: "",
    diagDiag: "",
  },

  onInit() {
    this._lastSendAt = 0;
    this._lastSwipe = "";
  },

  onShow() {
    // $app.$def 是 app.ux 导出的那个对象，页面与 app 共享同一实例
    const app = this.$app.$def;
    if (app && typeof app.attachPage === "function") {
      app.attachPage(this);
    }
  },

  onHide() {
    const app = this.$app.$def;
    if (app && typeof app.detachPage === "function") app.detachPage();
  },

  onDestroy() {
    const app = this.$app.$def;
    if (app && typeof app.detachPage === "function") app.detachPage();
  },

  /** 由 app.ux 推送链路状态。 */
  onStatus(status) {
    const linkOk = status.link === "connected";
    const listening = status.listening === true;

    if (this.linkOk !== linkOk) this.linkOk = linkOk;

    let text;
    if (status.link === "unknown") {
      text = "正在连接";
    } else if (!linkOk) {
      text = "未连接手机";
    } else if (!listening) {
      text = "手机手势服务未开";
    } else {
      text = "已连接";
    }
    if (this.statusText !== text) this.statusText = text;

    const batteryVisible = status.battery >= 0;
    if (this.batteryVisible !== batteryVisible) this.batteryVisible = batteryVisible;
    if (batteryVisible) {
      const batteryText = status.battery + "%";
      if (this.batteryText !== batteryText) this.batteryText = batteryText;
    }

    const padHint = linkOk && listening ? "滑动 / 点击" : "等待手机连接";
    if (this.padHint !== padHint) this.padHint = padHint;
  },

  /** 由 app.ux 推送手机回执。 */
  onAck(refId) {
    if (this.padHint === "已发送…") {
      this.padHint = this.linkOk ? "滑动 / 点击" : "等待手机连接";
    }
  },

  onSwipe(event) {
    if (!this.linkOk) {
      this.buzz();
      return;
    }
    const direction = event && event.direction;
    let dx = 0;
    let dy = 0;
    if (direction === "up") dy = -1;
    else if (direction === "down") dy = 1;
    else if (direction === "left") dx = -1;
    else if (direction === "right") dx = 1;
    else return;

    const now = Date.now();
    if (this._lastSwipe === direction && now - this._lastSendAt < COOLDOWN_MS) return;
    this._lastSwipe = direction;
    this._send({ t: "move", dx: dx, dy: dy });
  },

  onTap() {
    if (!this.linkOk) {
      this.buzz();
      return;
    }
    this._lastSwipe = "";
    this._send({ t: "tap" });
  },

  onBack() {
    if (!this.linkOk) return;
    this._send({ t: "back" });
  },

  onHome() {
    if (!this.linkOk) return;
    this._send({ t: "home" });
  },

  onRecents() {
    if (!this.linkOk) return;
    this._send({ t: "recents" });
  },

  /** 长按触摸板：打开完整诊断层。 */
  openDiag() {
    this.diagOpen = true;
    const app = this.$app.$def;
    if (app && typeof app.lastDetail === "function") {
      const d = app.lastDetail();
      this.diagCmd = d.cmd || "";
      this.diagCode = d.code || "";
      this.diagMsg = d.msg || "";
    }
    if (app && typeof app.readyState === "function") {
      app.readyState((status) => {
        const label = status === 1 ? "就绪" : (status === 2 ? "失败" : "未知");
        this.diagReady = "readyState=" + status + "(" + label + ")";
      });
    }
    // 官方另有两个诊断接口，一起显示，便于对比
    if (app && typeof app.apkStatus === "function") {
      const apk = app.apkStatus();
      this.diagApk = "apkStatus=" + apk;
    }
    if (app && typeof app.diagnosis === "function") {
      app.diagnosis((res) => {
        this.diagDiag = "diagnosis: " + res;
      });
    }
  },

  closeDiag() {
    this.diagOpen = false;
  },

  _send(cmd) {
    this._lastSendAt = Date.now();
    const app = this.$app.$def;
    if (!app || typeof app.send !== "function") {
      this.errorText = "app 实例不可用";
      return;
    }
    const name = cmd.t || "";

    // 先显示"发送中"，回调到了再更新——手环端没有 adb，页面是唯一反馈
    if (this.padHint !== "发送中 " + name) this.padHint = "发送中 " + name;

    const doSend = () => {
      app.send(cmd, (ok, err) => {
        const text = ok ? "已发送 " + name : "发送失败 " + name;
        if (this.padHint !== text) this.padHint = text;
        const short = (err || "").slice(0, 18);
        if (this.errorText !== short) this.errorText = short;
      });
    };

    // 官方流程：先确认 apkStatus 可用再发，否则必然 not connected
    if (typeof app.waitReady === "function") {
      app.waitReady((ready, status) => {
        if (!ready) {
          const text = "链路未就绪(" + status + ")";
          if (this.padHint !== text) this.padHint = text;
          this.errorText = "apkStatus=" + status;
          return;
        }
        doSend();
      });
    } else {
      doSend();
    }
  },

  /** 查一下连接状态，显示在页面上。 */
  checkReady() {
    const app = this.$app.$def;
    if (!app || typeof app.readyState !== "function") return;
    app.readyState((status) => {
      const text = status === 1 ? "链路已就绪" : "链路状态=" + status;
      if (this.padHint !== text) this.padHint = text;
    });
  },

  buzz() {
    const app = this.$app.$def;
    if (app && typeof app.buzz === "function") app.buzz();
  },
};
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding: 6px;
}
.status {
  flex-direction: row;
  align-items: center;
  height: 28px;
  padding-left: 4px;
  padding-right: 4px;
}
.dot { font-size: 16px; margin-right: 6px; }
.dot-ok { color: #00ff99; }
.dot-bad { color: #ff5555; }
.status-text { font-size: 15px; color: #cccccc; flex: 1; }
.battery { font-size: 15px; color: #888888; }
.pad {
  flex: 1;
  margin-top: 6px;
  margin-bottom: 6px;
  border-radius: 14px;
  border-width: 1px;
  border-color: #333333;
  background-color: #111111;
  justify-content: center;
  align-items: center;
}
.pad-hint { font-size: 17px; color: #666666; text-align: center; }
.pad-error { font-size: 12px; color: #ff6666; text-align: center; margin-top: 4px; }
.diag {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: #000000;
  flex-direction: column;
  padding: 10px;
}
.diag-title { font-size: 18px; color: #00ff99; font-weight: bold; margin-bottom: 6px; }
.diag-line { font-size: 13px; color: #ffffff; margin-bottom: 4px; }
.diag-tip { font-size: 12px; color: #666666; margin-top: auto; text-align: center; }
.keys { flex-direction: row; height: 62px; }
.key {
  flex: 1;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 12px;
  background-color: #1f1f1f;
  justify-content: center;
  align-items: center;
}
.key-label { font-size: 18px; color: #ffffff; text-align: center; }
</style>